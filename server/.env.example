NODE_ENV=development
PORT=3000

# PostgreSQL connection (the database is created by `npm run db:migrate`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdeskpro

# Frontend origin allowed by CORS and the CSRF origin check
CLIENT_URL=http://localhost:5173

# JWT signing secret: at least 32 random characters
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
